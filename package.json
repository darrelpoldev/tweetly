{
  "name": "tweetly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "start": "node dist/src/server/main.js",
    "dev:client": "vite",
    "test": "npm run build:server && node --test --test-concurrency=1 dist/test/**/*.test.js",
    "test:integration": "TEST_DATABASE_URL=postgresql://tweetly_test@127.0.0.1:54329/tweetly_test npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.45.1",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  }
}
